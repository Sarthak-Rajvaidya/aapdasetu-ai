# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Security (required) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Database ---
# Local development (SQLite):
DATABASE_URL=sqlite:///./dtms.db
# Production (PostgreSQL), example:
# DATABASE_URL=postgresql://user:password@host:5432/aapdasetu

# --- CORS ---
# Comma-separated list of allowed origins. Use * only for local dev.
CORS_ORIGINS=*

# --- AI Assistant / RAG ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- ML ---
# Optional override; defaults to Backend/app/ml/disaster_model.pkl
# ML_MODEL_PATH=
